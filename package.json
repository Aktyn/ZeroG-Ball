{
  "name": "zerog-ball",
  "version": "2.0.2",
  "description": "Logic game created for university project",
  "type": "module",
  "main": "./electron_src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "publish": "vite build",
    "w:publish": "vite build",
    "server:dev": "nodemon -e js --watch server_src/**/* --exec \"node server_src/server.cjs\"",
    "server:run": "node server_src/server.cjs",
    "test": "BABEL_DISABLE_CACHE=1 node ./tests/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "postinstall": "install-app-deps",
    "rebuild": "electron-rebuild",
    "electron": "npm run publish && electron ./electron_src/main.js",
    "electron:build": "npm run publish && build",
    "w:electron": "npm run w:publish && electron ./electron_src/main.js",
    "pack:windows": "npm run publish && electron-builder --win --x64 portable",
    "pack:linux": "npm run publish && electron-builder --linux --x64 portable"
  },
  "build": {
    "appId": "com.zerog.ball",
    "win": {
      "target": "portable",
      "icon": "./src/image/favicon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "./src/image/favicon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aktyn/ZeroG-Ball.git"
  },
  "keywords": [
    "ball",
    "sandbox",
    "logic",
    "game",
    "project",
    "javascript",
    "electron"
  ],
  "author": "Aktyn & Droni",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Aktyn/ZeroG-Ball/issues"
  },
  "homepage": "https://github.com/Aktyn/ZeroG-Ball#readme",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-legacy": "^7.1.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.19",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "colors": "^1.4.0",
    "express": "^5.1.0"
  }
}
